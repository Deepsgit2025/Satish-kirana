# Copy to .env and fill in. NEVER commit .env

# --- database ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=ssbazar
PGUSER=ssbazar_app
PGPASSWORD=

# --- this device ---
DEVICE_CODE=C1              # C1 | C2 | OFFICE | SERVER
DEVICE_TYPE=counter         # counter | office | server
SERVER_URL=http://192.168.1.10:4000

# --- printing ---
PRINTER_IP=192.168.1.21
PRINTER_PORT=9100
LABEL_PRINTER_IP=192.168.1.25

# --- localisation ---
DEFAULT_LANGUAGE=en         # en | hi
STORE_STATE_CODE=23         # 23 = Madhya Pradesh

# --- backup (server only) ---
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BACKUP_PASSPHRASE=          # also keep a paper copy OFF this machine

# Local backup — build-order step 8, docs/backup.md.
# Holds dumps/, base/ and wal/. The Postgres service account writes into wal/
# through archive_command, so on Windows this belongs somewhere machine-wide
# (C:\ProgramData\ssbazar\backups) rather than under a user profile.
BACKUP_LOCAL_DIR=/var/backups/ssbazar
BACKUP_RETENTION_DAYS=7     # dumps older than this are pruned; the newest never is
BACKUP_BASE_EVERY_DAYS=7    # pg_basebackup cadence — the anchor the WAL archive replays onto
BACKUP_VERIFY_DATABASE=     # scratch database restore-verify builds and drops; defaults to <PGDATABASE>_verify
BACKUP_VERIFY_PGUSER=      # role restore-verify does its CREATEDB work as; blank = same as PGUSER (D47)
BACKUP_VERIFY_PGPASSWORD=  # its password. Setting this without BACKUP_VERIFY_PGUSER is refused, not ignored
BACKUP_MAINTENANCE_DATABASE= # where CREATE/DROP DATABASE are issued; defaults to postgres
PG_BIN_DIR=                 # pg_dump/pg_restore/pg_basebackup, when not on PATH (a scheduled task's PATH is not yours)
