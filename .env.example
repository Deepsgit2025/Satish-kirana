# Copy to .env and fill in. NEVER commit .env

# --- database ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=ssbazar
PGUSER=ssbazar_app
PGPASSWORD=

# --- this device ---
DEVICE_CODE=C1              # C1 | C2 | OFFICE | SERVER
DEVICE_TYPE=counter         # counter | office | server
SERVER_URL=http://192.168.1.10:4000

# --- printing ---
PRINTER_IP=192.168.1.21
PRINTER_PORT=9100
LABEL_PRINTER_IP=192.168.1.25

# --- localisation ---
DEFAULT_LANGUAGE=en         # en | hi
STORE_STATE_CODE=23         # 23 = Madhya Pradesh

# --- backup (server only) ---
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BACKUP_PASSPHRASE=          # also keep a paper copy OFF this machine
BACKUP_LOCAL_DIR=/var/backups/ssbazar
