{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node"],
    "paths": {
      "@ssbazar/shared": ["./packages/shared/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "server/src/**/*.ts",
    "apps/*/src/**/*.ts",
    "vitest.config.ts"
  ]
}
