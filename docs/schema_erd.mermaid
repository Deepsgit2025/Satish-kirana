        numeric qty
        numeric free_qty "10+1 schemes"
        bigint unit_id FK
        numeric conversion_factor
        numeric rate
        enum rate_tax_type "inclusive exclusive"
        numeric discount_amount
        numeric taxable_amount "rounded per line"
        numeric cgst_rate "frozen"
        numeric cgst_amount
        int tax_group_index "printed 1) 2)"
        numeric cost_rate "for bill-wise profit"
        bigint location_id FK
    }

