    EMPLOYEE_PAY_RATES {
        bigint id PK
        bigint employee_id FK
        enum pay_type "daily monthly"
        numeric pay_rate
        numeric overtime_rate_per_hour
        numeric half_day_pay_pct
        date effective_from
        date effective_to "null = current"
    }

    EMPLOYEE_ADVANCES {
        bigint id PK
        bigint employee_id FK
        enum entry_type "opening advance_given recovered"
        numeric amount "signed"
        numeric balance_after
        bigint salary_run_id FK
        bigint account_id FK "cash leaves the drawer"
        date entry_date
    }

    SALARY_RUNS {
        bigint id PK
        bigint employee_id FK
        date period_month UK
        numeric pay_rate "snapshot"
        int full_days "snapshot"
        int half_days "snapshot"
        int absent_days "snapshot"
        numeric overtime_hours
        numeric gross_amount
        numeric advance_opening "snapshot"
        numeric advance_recovered
        numeric advance_closing "snapshot"
        numeric cash_paid
        enum status "draft paid cancelled"
        date paid_on
    }

    SALARY_PAYMENTS {
        bigint id PK
        bigint salary_run_id FK
        enum payment_mode "cash upi bank_transfer"
        bigint account_id FK
        numeric amount
        date paid_on
    }

