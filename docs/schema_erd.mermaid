    TRANSACTIONS {
        bigint id PK
        uuid uuid UK "made on counter, sync key"
        enum txn_type "sale purchase credit_note payment_in expense"
        varchar txn_number "452104015-001397"
        bigint financial_year_id FK
        bigint device_id FK
        bigint party_id FK "null for walk-in"
        bigint ref_txn_id FK "credit note to sale"
        bigint cashier_id FK
        varchar cashier_name "snapshot, prints"
        bigint day_session_id FK
        bigint attendance_day_id FK "backfilled"
        bigint expense_category_id FK
        timestamptz txn_datetime "business time"
        varchar place_of_supply "IGST vs CGST+SGST"
        varchar buyer_gstin "null = B2C, normal case"
        numeric bill_discount_amount
        numeric additional_charges
        numeric taxable_amount
        numeric round_off
        numeric net_amount
        numeric paid_amount
        numeric balance_amount
        enum payment_status "paid partial unpaid"
        numeric mrp_savings
        int points_earned
        text remarks
        timestamptz synced_at "null = offline only"
        enum status "draft parked completed void"
    }

    TRANSACTION_LINES {
        bigint id PK
        bigint txn_id FK
        bigint product_id FK
        varchar description "snapshot"
